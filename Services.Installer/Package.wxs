<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="ServicesApp 服务管理工具"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.ProductVersion)"
           UpgradeCode="7C4E9A2B-1D3F-4A8E-9B6C-5D2F8E1A0C3B"
           Scope="perMachine"
           Language="2052"
           Codepage="936">

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本，无法降级。" />
    <MediaTemplate EmbedCab="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Icon Id="AppIcon.ico" SourceFile="..\ServicesApp\Assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ServicesApp" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="ServicesApp" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Component Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="ServicesApp"
                Description="Windows 后台服务管理工具"
                Target="[INSTALLFOLDER]ServicesApp.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <Shortcut Id="ApplicationDesktopShortcut"
                Directory="DesktopFolder"
                Name="ServicesApp"
                Description="Windows 后台服务管理工具"
                Target="[INSTALLFOLDER]ServicesApp.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\ServicesApp" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- 将安装目录加入系统 PATH，使 servicesctl 命令可在任意终端直接使用 -->
    <Component Id="CliPathEnv" Directory="INSTALLFOLDER">
      <Environment Id="PathEnv" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\ServicesApp" Name="CliInPath" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      安装 / 升级后执行 servicesctl migrate：将新版本包装器部署到 %ProgramData%\ServicesApp\wrapper，
      把服务切换到新版本并清理不再使用的旧版本（运行中的服务重启后生效）。
      服务运行的是该目录中的副本，因此升级时安装目录中的文件不会被锁定，无需停止服务。失败不影响安装。
      卸载时不删除该目录：仍存在的服务依赖它继续运行；删除全部服务后执行 migrate 即可清空。
    -->
    <CustomAction Id="MigrateServiceWrappers"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]servicesctl.exe&quot; migrate"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="MigrateServiceWrappers" Before="InstallFinalize" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="ServicesApp">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="CliFiles" />
      <ComponentGroupRef Id="WrapperFiles" />
      <ComponentRef Id="Shortcuts" />
      <ComponentRef Id="CliPathEnv" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
  </Package>
</Wix>
