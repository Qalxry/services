<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>ServicesApp</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <Cultures>zh-CN</Cultures>
    <DefineConstants>ProductVersion=$(Version);Manufacturer=$(Manufacturer)</DefineConstants>
    <SuppressIces>ICE03</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServicesApp\ServicesApp.csproj"
                      Publish="true"
                      Properties="RuntimeIdentifier=win-x64;SelfContained=false;PublishSingleFile=false" />
    <!-- 命令行工具：自包含单文件，与 ServicesApp.exe 安装到同一目录 -->
    <ProjectReference Include="..\Services.Cli\Services.Cli.csproj"
                      Publish="true"
                      Properties="RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="obj\$(Platform)\$(Configuration)\publish\ServicesApp">
      <ComponentGroupName>AppFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <BindPath Include="obj\$(Platform)\$(Configuration)\publish\ServicesApp" />
    <HarvestDirectory Include="obj\$(Platform)\$(Configuration)\publish\Services.Cli">
      <ComponentGroupName>CliFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <BindPath Include="obj\$(Platform)\$(Configuration)\publish\Services.Cli" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
