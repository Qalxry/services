<Window
    x:Class="ServicesApp.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ServicesApp"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="LogItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="20"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>

            <!-- AnsiText.Entry 负责渲染 ANSI 颜色，并为 stderr 行显示左侧色条；两个模板仅换行方式不同 -->
            <DataTemplate x:Key="WrapLogTemplate">
                <Border local:AnsiText.Entry="{Binding}"
                        BorderThickness="2,0,0,0"
                        Padding="6,0,0,0">
                    <TextBlock FontFamily="Consolas" 
                               FontSize="12" 
                               TextWrapping="Wrap" 
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NoWrapLogTemplate">
                <Border local:AnsiText.Entry="{Binding}"
                        BorderThickness="2,0,0,0"
                        Padding="6,0,0,0">
                    <TextBlock FontFamily="Consolas" 
                               FontSize="12" 
                               TextWrapping="NoWrap" 
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="*"/>    <!-- Log Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Height="40" Grid.Row="0" Background="Transparent" Padding="16,0">
             <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xF000;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="TitleText" Text="日志" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8"/>
            </StackPanel>
        </Grid>

        <!-- Log List (Virtualized) -->
        <Grid Grid.Row="1" Padding="16,0,16,8">
            <ListView x:Name="LogListView" 
                      SelectionMode="None"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      CornerRadius="8"
                      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      Padding="8"
                      ItemTemplate="{StaticResource WrapLogTemplate}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource LogItemStyle}"/>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Padding="16,0,16,16">
            <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="显示:" VerticalAlignment="Center" Opacity="0.7"/>
                <CheckBox x:Name="StdoutCheck" Content="stdout" IsChecked="True" MinWidth="0"
                          Checked="OnStreamFilterChanged" Unchecked="OnStreamFilterChanged"
                          ToolTipService.ToolTip="标准输出"/>
                <CheckBox x:Name="StderrCheck" Content="stderr" IsChecked="True" MinWidth="0"
                          Checked="OnStreamFilterChanged" Unchecked="OnStreamFilterChanged"
                          ToolTipService.ToolTip="标准错误输出（左侧带色条标记）"/>
                <AppBarSeparator/>
                <CheckBox x:Name="WrapCheck" Content="文本换行" IsChecked="True" MinWidth="0"
                          Checked="OnWordWrapChanged" Unchecked="OnWordWrapChanged"
                          ToolTipService.ToolTip="关闭后长行不折行，可横向滚动查看"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton" Click="OnRefreshClick" ToolTipService.ToolTip="强制刷新">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFolderButton" Click="OnOpenFolderClick" ToolTipService.ToolTip="打开所在文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="12"/>
                        <TextBlock Text="打开日志文件"/>
                    </StackPanel>
                </Button>
                <Button Click="OnCloseClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        <TextBlock Text="关闭"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>